# ==============================================================================
# CRPF Tender Evaluation & Eligibility Analysis Platform — Environment Template
# ==============================================================================
# INSTRUCTIONS: Copy this file to .env and configure environment-specific values.
# NEVER commit real production secrets or API keys to version control.
# ==============================================================================

# Primary AI / LLM Configuration (Gemini)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Optional AI Fallback Configuration (Groq)
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_API_KEY=your_optional_groq_api_key_here
LLM_FALLBACK_MODEL=openai/gpt-oss-120b

# Vision-Language Model Configuration
VLM_PROVIDER=gemini
VLM_MODEL=gemini-2.5-flash

# Local Embeddings (BAAI/bge-m3 with PostgreSQL pgvector)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=

# Local PostgreSQL Database
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tender_evaluation

# Local S3-Compatible Object Storage (MinIO)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=tender-documents
S3_REGION=us-east-1

# Deterministic Open Policy Agent (OPA)
OPA_URL=http://opa:8181

# JWT Authentication & Security
JWT_SECRET_KEY=replace_with_a_cryptographically_secure_random_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000"]

# Processing & Document Security Limits
MAX_UPLOAD_SIZE_MB=50
MAX_DOCUMENT_PAGES=500
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=300

# Document Worker Configuration
WORKER_CONCURRENCY=2
WORKER_TIMEOUT_SECONDS=300

# Hybrid Retrieval Settings
RETRIEVAL_TOP_K=10

# Logging Level
LOG_LEVEL=INFO
